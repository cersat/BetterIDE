@@ -317,3 +317,33 @@ func (s *Sketch) ToRPC() *rpc.Sketch {
 	}
 	return res
 }
+
+// UseMainFile compiles the given `.ino` (or `.pde`) file as the main file of the sketch instead of the one
+// named after the sketch folder, and leaves out the other `.ino` and `.pde` files of the sketch. The file can be
+// outside of the sketch folder. When onlyMainFile is true, the additional files (`.c`, `.cpp`, `.h`, the `src`
+// folder, etc.) are left out too, so only the main file is compiled.
+func (s *Sketch) UseMainFile(mainFile *paths.Path, onlyMainFile bool) error {
+	mainFile = mainFile.Canonical()
+	if !globals.MainFileValidExtensions[mainFile.Ext()] {
+		return errors.New(i18n.Tr("not a valid main sketch file: %s", mainFile))
+	}
+	if exist, err := mainFile.ExistCheck(); err != nil {
+		return fmt.Errorf("%s: %w", i18n.Tr("main file is not valid"), err)
+	} else if !exist {
+		return fmt.Errorf("%s: %s", i18n.Tr("no such file or directory"), mainFile)
+	}
+	s.MainFile = mainFile
+	s.OtherSketchFiles = paths.PathList{}
+	if onlyMainFile {
+		s.AdditionalFiles = paths.PathList{}
+	}
+	return nil
+}
+
+// MainFileBuildName is the name of the files generated from the main file during the build and of the build
+// artifacts (`<name>.ino.cpp`, `<name>.ino.hex`, etc.). It does not depend on which file is compiled as the main
+// file (see UseMainFile), so switching the main file leaves no stale generated files in the build folder and the
+// upload finds the artifacts.
+func (s *Sketch) MainFileBuildName() string {
+	return s.Name + s.MainFile.Ext()
+}
